{
  "name": "audio-capture",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && tsc -p electron/tsconfig.json && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ electron/"
  },
  "dependencies": {
    "eventemitter3": "5.0.1",
    "framer-motion": "11.15.0",
    "lucide-react": "^1.28.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@types/node": "22.10.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "electron": "32.3.2",
    "electron-builder": "25.1.8",
    "electron-rebuild": "3.2.9",
    "eslint": "9.16.0",
    "eslint-plugin-react": "7.37.3",
    "eslint-plugin-react-hooks": "5.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.5",
    "vitest": "3.0.4",
    "wait-on": "8.0.1"
  }
}
