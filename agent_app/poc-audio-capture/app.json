{
  "expo": {
    "name": "PoC Audio Capture",
    "slug": "poc-audio-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "poc-audio-capture",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.copilot.poc-audio-capture",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "com.copilot.poc_audio_capture",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F"
      }
    },
    "plugins": [
      "expo-router"
    ]
  }
}
